{
  "build": {
    "beforeBuildCommand": "node ../../scripts/build-macos-finder.mjs && yarn build"
  },
  "app": {
    "windows": [
      {
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "width": 1060,
        "height": 770,
        "minWidth": 1020,
        "minHeight": 580,
        "visible": false
      }
    ]
  },
  "bundle": {
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "PlugIns/AnyDropFinder.appex": ".generated/AnyDropFinder.appex"
      }
    },
    "targets": [
      "app",
      "dmg"
    ]
  }
}
